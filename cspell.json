{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "node_modules",
    "dist",
    ".nuxt",
    ".output",
    "coverage",
    ".git",
    "*.log",
    ".changeset",
    "**/dist/**",
    "**/node_modules/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/coverage/**",
    ".gitee/**",
    ".github/**",
    ".husky/**",
    "docs/**"
  ],
  "words": [
    "ai-qa",
    "allowSyntheticDefaultImports",
    "antd",
    "api-server",
    "autoprefixer",
    "bcrypt",
    "class-transformer",
    "class-validator",
    "composables",
    "cwd",
    "dtos",
    "dts",
    "emitDecoratorMetadata",
    "endofline",
    "esbenp",
    "eslint",
    "esModuleInterop",
    "experimentalDecorators",
    "forceConsistentCasingInFileNames",
    "gitee",
    "isolatedModules",
    "jest",
    "jsx",
    "lucide",
    "mysql",
    "NestJS",
    "nodenext",
    "noImplicitAny",
    "nuxt",
    "Nuxt",
    "pinia",
    "postcss",
    "prettier",
    "reflect-metadata",
    "rxjs",
    "skipLibCheck",
    "supertest",
    "swagger-ui",
    "tailwindcss",
    "titte",
    "ts-jest",
    "ts-node",
    "tseslint",
    "tsx",
    "typeorm",
    "typescript",
    "vite",
    "vitest",
    "volars",
    "vue",
    "vue-eslint-parser",
    "web-client"
  ],
  "flagWords": [],
  "patterns": [
    {
      "name": "BlockComments",
      "pattern": "/\\*([^*]|\\*[^/])*\\*/",
      "description": "Ignore block comments"
    },
    {
      "name": "LineComments",
      "pattern": "//.*",
      "description": "Ignore line comments"
    }
  ]
}
